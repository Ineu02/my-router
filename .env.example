# ══════════════════════════════════════════════════════════════════════
#  LLM ROUTER — configuration template
#  Copy to `.env` and fill in.  NEVER commit the real `.env`.
#      cp .env.example .env
# ══════════════════════════════════════════════════════════════════════

# ── Router server ─────────────────────────────────────────────────────
ROUTER_PORT=20128
ROUTER_HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# ── Client authentication ─────────────────────────────────────────────
# Keys your agents/apps use:  Authorization: Bearer sk-router-...
# This bootstrap key is seeded into the DB on first start.
# Generate one:  node -e "console.log('sk-router-'+require('crypto').randomBytes(24).toString('hex'))"
ROUTER_API_KEY=sk-router-CHANGE-ME--generate-your-own

# Set false to allow unauthenticated access (local-only; not recommended).
REQUIRE_API_KEY=true

# ── Admin / dashboard authentication ──────────────────────────────────
# SEPARATE from client keys. A leaked sk-router-* key must NOT grant
# access to provider credentials. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=CHANGE-ME-admin-token-min-16-chars
# Signs the dashboard session cookie. Generate the same way.
SESSION_SECRET=CHANGE-ME-session-secret-min-32-chars-long

# ── Database ──────────────────────────────────────────────────────────
# SQLite today; the repository layer is driver-agnostic so a
# postgres:// URL can be supported later without touching callers.
DATABASE_URL=file:./data/router.db

# ── Routing behaviour ─────────────────────────────────────────────────
DEFAULT_PROFILE=general
MAX_FALLBACK_ATTEMPTS=4
REQUEST_TIMEOUT_MS=60000
CONNECT_TIMEOUT_MS=10000
GLOBAL_DEADLINE_MS=120000
ROTATION_STRATEGY=health-based
RETRY_NETWORK_ERRORS=1

# ── Health tracking ───────────────────────────────────────────────────
HEALTH_FAILURE_THRESHOLD=3
HEALTH_COOLDOWN_BASE_MS=5000
HEALTH_MAX_COOLDOWN_MS=300000
HEALTH_PROBE_INTERVAL_MS=60000
HEALTH_SUCCESS_RESET=1

# ── Rate limiting / request limits ────────────────────────────────────
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
MAX_BODY_BYTES=2097152

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the admin API.
CORS_ORIGINS=http://localhost:3000

# ── Logging ───────────────────────────────────────────────────────────
LOG_REQUESTS=true
# Prompt bodies are NEVER logged when false. Keep false.
LOG_PROMPTS=false
LOG_RETENTION_DAYS=30

# ══════════════════════════════════════════════════════════════════════
#  PROVIDER CREDENTIALS
#  Leave blank to disable a provider. Any provider with a key present is
#  auto-registered on boot. These are read server-side only and are NEVER
#  sent to the dashboard or returned by any API response.
# ══════════════════════════════════════════════════════════════════════

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=

# ── Multiple accounts per provider (rotation) ─────────────────────────
# Suffix _2, _3, ... for extra accounts of the same provider.
# OPENAI_API_KEY_2=
# ANTHROPIC_API_KEY_2=
# GEMINI_API_KEY_2=

# ── Optional base-URL overrides (proxies, Azure, self-hosted) ──────────
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# XAI_BASE_URL=https://api.x.ai/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ── Custom OpenAI-compatible provider ─────────────────────────────────
CUSTOM_PROVIDER_BASE_URL=
CUSTOM_PROVIDER_API_KEY=
CUSTOM_PROVIDER_MODELS=

# ── Local mock provider (testing — costs nothing) ─────────────────────
# Enables a built-in fake upstream so the whole path can be proven
# end-to-end without spending credits. Turn OFF in production.
ENABLE_MOCK_PROVIDER=true
MOCK_PROVIDER_PORT=20129
